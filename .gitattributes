# Normalise line endings so a Windows checkout and the ubuntu Actions runner
# produce byte-identical files. Without this, a locally-run pipeline rewrites
# every line of every CSV/JSON as CRLF and the diff shows 100% churn
# (measured: 258,101 changed lines across Results/ for zero content change).
* text=auto eol=lf

*.csv   text eol=lf
*.json  text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ipynb text eol=lf
*.md    text eol=lf
*.txt   text eol=lf

# Binary hand-off artefacts - never diff or normalise these.
*.pkl   binary
*.png   binary
*.xlsx  binary
